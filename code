<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Among Us Chat</title>
    <style>
        body {
            font-family: 'Courier New', monospace;
            margin: 0;
            overflow: hidden;
            background-color: #000;
            color: #fff;
            display: flex;
            height: 100vh;
        }
        
        #chat-container {
            width: 300px;
            height: 100vh;
            border-right: 2px solid #ff5555;
            display: flex;
            flex-direction: column;
            background-color: rgba(0, 0, 0, 0.8);
            z-index: 10;
        }
        
        #chat-messages {
            flex-grow: 1;
            overflow-y: auto;
            padding: 10px;
        }
        
        #chat-input-container {
            display: none;
            padding: 10px;
        }
        
        #username-container {
            padding: 20px;
            text-align: center;
        }
        
        input, button {
            background-color: #222;
            color: #fff;
            border: 1px solid #ff5555;
            padding: 8px;
            margin: 5px 0;
            font-family: inherit;
        }
        
        button {
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        button:hover {
            background-color: #ff5555;
        }
        
        .message {
            margin-bottom: 10px;
            word-wrap: break-word;
        }
        
        .username {
            color: #ff5555;
            font-weight: bold;
        }
        
        #particles {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        
        .particle {
            position: absolute;
            width: 2px;
            height: 2px;
            background-color: rgba(255, 85, 85, 0.5);
            border-radius: 50%;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <div id="particles"></div>
    <div id="chat-container">
        <div id="username-container">
            <h2>Among Us Chat</h2>
            <input type="text" id="username-input" placeholder="Enter username">
            <button id="join-chat">Join Chat</button>
        </div>
        <div id="chat-messages"></div>
        <div id="chat-input-container">
            <input type="text" id="chat-input" placeholder="Type message...">
            <button id="send-button">Send</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.2/socket.io.js"></script>
    <script>
        const socket = io();
        let username = '';
        
        // Join chat handler
        document.getElementById('join-chat').addEventListener('click', () => {
            username = document.getElementById('username-input').value.trim();
            if (username) {
                document.getElementById('username-container').style.display = 'none';
                document.getElementById('chat-input-container').style.display = 'block';
                socket.emit('user joined', username);
            }
        });
        
        // Send message handler
        document.getElementById('send-button').addEventListener('click', sendMessage);
        document.getElementById('chat-input').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });
        
        function sendMessage() {
            const message = document.getElementById('chat-input').value.trim();
            if (message) {
                socket.emit('chat message', { username, message });
                document.getElementById('chat-input').value = '';
            }
        }
        
        // Receive messages
        socket.on('chat message', (data) => {
            const messagesDiv = document.getElementById('chat-messages');
            const messageElement = document.createElement('div');
            messageElement.className = 'message';
            messageElement.innerHTML = `<span class="username">${data.username}:</span> ${data.message}`;
            messagesDiv.appendChild(messageElement);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        });
        
        // Particles effect
        const particles = document.getElementById('particles');
        const particlesArray = [];
        
        document.addEventListener('mousemove', (e) => {
            createParticle(e.clientX, e.clientY);
        });
        
        function createParticle(x, y) {
            const particle = document.createElement('div');
            particle.className = 'particle';
            particle.style.left = `${x}px`;
            particle.style.top = `${y}px`;
            particles.appendChild(particle);
            
            const particleObj = {
                element: particle,
                x: x,
                y: y,
                velocityX: (Math.random() - 0.5) * 2,
                velocityY: (Math.random() - 0.5) * 2,
                lifespan: Math.random() * 100 + 50
            };
            
            particlesArray.push(particleObj);
            
            setTimeout(() => {
                particle.remove();
                particlesArray.splice(particlesArray.indexOf(particleObj), 1);
            }, particleObj.lifespan);
        }
        
        function animateParticles() {
            particlesArray.forEach(particle => {
                particle.x += particle.velocityX;
                particle.y += particle.velocityY;
                particle.element.style.left = `${particle.x}px`;
                particle.element.style.top = `${particle.y}px`;
                particle.element.style.opacity = particle.lifespan / 150;
                particle.lifespan -= 1;
            });
            requestAnimationFrame(animateParticles);
        }
        
        animateParticles();
        
        // Vercel deployment
        const vercelEnv = '<%= process.env.VERCEL_ENV %>';
        if (vercelEnv === 'production') {
            console.log('Running on Vercel production');
        }
    </script>
</body>
</html>
