<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Among Us Chat</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #000;
            font-family: 'Courier New', monospace;
            overflow: hidden;
            color: white;
        }
        
        #chat-container {
            position: fixed;
            right: 0;
            top: 0;
            width: 300px;
            height: 100vh;
            background-color: rgba(0, 0, 0, 0.8);
            border-left: 2px solid #ff5555;
            display: flex;
            flex-direction: column;
            padding: 10px;
            box-sizing: border-box;
        }
        
        #chat-messages {
            flex-grow: 1;
            overflow-y: auto;
            margin-bottom: 10px;
            padding-right: 5px;
        }
        
        .message {
            margin-bottom: 8px;
            word-wrap: break-word;
        }
        
        .username {
            color: #ff5555;
            font-weight: bold;
        }
        
        #input-container {
            display: flex;
            gap: 5px;
        }
        
        #message-input {
            flex-grow: 1;
            padding: 8px;
            background-color: #111;
            border: 1px solid #ff5555;
            color: white;
        }
        
        #send-button {
            background-color: #ff5555;
            color: white;
            border: none;
            padding: 8px 15px;
            cursor: pointer;
        }
        
        #username-container {
            margin-bottom: 20px;
        }
        
        #username-input {
            padding: 8px;
            background-color: #111;
            border: 1px solid #ff5555;
            color: white;
            width: calc(100% - 90px);
        }
        
        #join-button {
            background-color: #55ff55;
            color: black;
            border: none;
            padding: 8px 15px;
            cursor: pointer;
            margin-top: 5px;
        }
        
        .particle {
            position: absolute;
            width: 5px;
            height: 5px;
            background-color: #ff5555;
            border-radius: 50%;
            pointer-events: none;
            z-index: -1;
        }
        
        h2 {
            color: #ff5555;
            text-align: center;
            margin-top: 0;
            border-bottom: 1px solid #ff5555;
            padding-bottom: 5px;
        }
    </style>
</head>
<body>
    <div id="chat-container">
        <h2>AMONG US CHAT</h2>
        <div id="username-container">
            <input type="text" id="username-input" placeholder="Enter your username">
            <button id="join-button">JOIN CHAT</button>
        </div>
        <div id="chat-messages"></div>
        <div id="input-container">
            <input type="text" id="message-input" placeholder="Type your message..." disabled>
            <button id="send-button" disabled>SEND</button>
        </div>
    </div>
    
    <script>
        const usernameInput = document.getElementById('username-input');
        const joinButton = document.getElementById('join-button');
        const chatMessages = document.getElementById('chat-messages');
        const messageInput = document.getElementById('message-input');
        const sendButton = document.getElementById('send-button');
        let username = '';
        let particles = [];
        joinButton.addEventListener('click', () => {
            username = usernameInput.value.trim();
            if (username) {
                usernameInput.disabled = true;
                joinButton.disabled = true;
                messageInput.disabled = false;
                sendButton.disabled = false;
                const welcomeMessage = document.createElement('div');
                welcomeMessage.className = 'message';
                welcomeMessage.innerHTML = `<span style="color: #55ff55;">Welcome, <span class="username">${username}</span>!</span>`;
                chatMessages.appendChild(welcomeMessage);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        });
        
        function sendMessage() {
            const messageText = messageInput.value.trim();
            if (messageText) {
                const messageElement = document.createElement('div');
                messageElement.className = 'message';
                messageElement.innerHTML = `<span class="username">${username}:</span> ${messageText}`;
                chatMessages.appendChild(messageElement);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                messageInput.value = '';
            }
        }
        
        sendButton.addEventListener('click', sendMessage);
        
        messageInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
        
        // Particle effect
        document.addEventListener('mousemove', (e) => {
            for (let i = 0; i < 3; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                document.body.appendChild(particle);
                
                const size = Math.random() * 5 + 2;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                
                particle.style.left = `${e.pageX + (Math.random() * 20 - 10)}px`;
                particle.style.top = `${e.pageY + (Math.random() * 20 - 10)}px`;
                
                particles.push({
                    element: particle,
                    x: e.pageX,
                    y: e.pageY,
                    vx: Math.random() * 2 - 1,
                    vy: Math.random() * 2 - 1,
                    lifespan: 100 + Math.random() * 50
                });
            }
            
            // Limit particles to prevent performance issues
            if (particles.length > 100) {
                const toRemove = particles.splice(0, particles.length - 100);
                toRemove.forEach(p => p.element.remove());
            }
        });
        
        function animateParticles() {
            particles.forEach((p, index) => {
                p.x += p.vx;
                p.y += p.vy;
                p.lifespan--;
                
                p.element.style.left = `${p.x}px`;
                p.element.style.top = `${p.y}px`;
                p.element.style.opacity = p.lifespan / 150;
                
                if (p.lifespan <= 0) {
                    p.element.remove();
                    particles.splice(index, 1);
                }
            });
            
            requestAnimationFrame(animateParticles);
        }
        
        animateParticles();
    </script>
</body>
</html>
